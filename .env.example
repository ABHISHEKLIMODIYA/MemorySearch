# Embedding Model Configuration
# Recommended local multilingual sentence transformer: sentence-transformers/paraphrase-multilingual-mpnet-base-v2 or sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB directory
CHROMA_DIR=data/chroma_db

# Optional LLM Configuration (If omitted, system uses deterministic local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hybrid Search Weighting Parameters
WEIGHT_SEMANTIC=0.55
WEIGHT_KEYWORD=0.20
WEIGHT_METADATA=0.15
WEIGHT_DECISION=0.10

# Backend Host & Port
HOST=127.0.0.1
PORT=8000
